{
  "productName": "Medza Agents",
  "version": "0.34.0",
  "identifier": "ai.medza.agents",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:vite",
    "beforeBuildCommand": "npm run build:vite"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Medza Agents",
        "width": 1000,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost https://asset.localhost https://*.ytimg.com https://img.youtube.com https://*.ggpht.com medzavideo: http://medzavideo.localhost; connect-src 'self' data: blob: asset: http://asset.localhost https://asset.localhost ipc: http://ipc.localhost; media-src 'self' data: blob: asset: http://asset.localhost https://asset.localhost medzavideo: http://medzavideo.localhost; worker-src 'self' blob:; frame-src 'self' medzavideo: http://medzavideo.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**"
          ],
          "deny": [
            "$HOME/.ssh",
            "$HOME/.ssh/**",
            "$HOME/.gnupg/**",
            "$HOME/.tauri",
            "$HOME/.tauri/**",
            "$HOME/.aws/**",
            "$HOME/.config/gh/**",
            "$HOME/.docker/config.json",
            "$HOME/.netrc",
            "$HOME/.git-credentials",
            "$HOME/.npmrc",
            "$HOME/.zshrc",
            "$HOME/.zshenv",
            "$HOME/.zprofile",
            "$HOME/.zlogin",
            "$HOME/.bashrc",
            "$HOME/.bash_profile",
            "$HOME/.profile",
            "$HOME/Library/Keychains/**",
            "$HOME/Library/LaunchAgents/**",
            "$HOME/Library/Cookies/**",
            "$HOME/Library/Application Support/*/engine.token",
            "$HOME/Library/Application Support/*/mobile.json",
            "$HOME/Library/Application Support/*/telegram.json",
            "$HOME/Library/Application Support/*/rotina/telegram-rotina.json",
            "$HOME/Library/Application Support/*/rotina/google.json",
            "$HOME/.codex/auth.json",
            "$HOME/Library/Application Support/OMNI-AGENTS/profiles/**/auth.json",
            "**/.credentials.json",
            "**/.claude.json",
            "/Applications/*.app/**"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "resources": {
      "../skills/basicas/": "skills/basicas/",
      "../skills/video/": "skills/video/"
    },
    "externalBin": [
      "binaries/omni-engine",
      "binaries/omni-shim"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "pubkey": "",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
