{
  "identifier": "default",
  "description": "Default capability for Niski",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-text-file",
    "fs:allow-read-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-copy-file",
    "fs:allow-write-file",
    { "identifier": "fs:scope", "allow": ["**"], "deny": [
      "$HOME/.ssh",
      "$HOME/.ssh/**",
      "$HOME/.gnupg/**",
      "$HOME/.tauri",
      "$HOME/.tauri/**",
      "$HOME/.aws/**",
      "$HOME/.config/gh/**",
      "$HOME/.docker/config.json",
      "$HOME/.netrc",
      "$HOME/.git-credentials",
      "$HOME/.npmrc",
      "$HOME/.zshrc",
      "$HOME/.zshenv",
      "$HOME/.zprofile",
      "$HOME/.zlogin",
      "$HOME/.bashrc",
      "$HOME/.bash_profile",
      "$HOME/.profile",
      "$HOME/Library/Keychains/**",
      "$HOME/Library/LaunchAgents/**",
      "$HOME/Library/Cookies/**",
      "$HOME/Library/Application Support/*/engine.token",
      "$HOME/Library/Application Support/*/mobile.json",
      "$HOME/Library/Application Support/*/telegram.json",
      "$HOME/Library/Application Support/*/rotina/telegram-rotina.json",
      "$HOME/Library/Application Support/*/rotina/google.json",
      "$HOME/.codex/auth.json",
      "$HOME/Library/Application Support/OMNI-AGENTS/profiles/**/auth.json",
      "**/.credentials.json",
      "**/.claude.json",
      "/Applications/*.app/**"
    ] },
    "notification:default",
    "core:window:allow-request-user-attention",
    "core:window:allow-set-icon",
    "core:window:allow-is-focused",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "opener:allow-reveal-item-in-dir",
    { "identifier": "opener:allow-open-url", "allow": [
      { "url": "https://login.tailscale.com/*" },
      { "url": "https://tailscale.com/*" },
      { "url": "https://code.claude.com/*" },
      { "url": "https://learn.chatgpt.com/*" },
      { "url": "https://cursor.com/*" },
      { "url": "https://github.com/Medza-Primos-Organizacao/medza-agentes-releases/releases" },
      { "url": "https://*.ts.net/*" },
      { "url": "http://100.*/*" },
      { "url": "https://accounts.google.com/*" },
      { "url": "https://console.cloud.google.com/*" },
      { "url": "https://t.me/*" }
    ] }
  ]
}
